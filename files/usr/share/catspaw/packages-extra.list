# Packages layered on top of the Hyprland session. Some come from COPRs that
# may lag a Fedora release; build.sh installs these with --skip-unavailable and
# catspaw-verify reports whatever didn't make it in.

# what the rice configs expect
ghostty
wezterm
yazi
starship
swappy
kvantum
qt5ct
qt6ct
nwg-dock-hyprland
quickshell
ags

# hyprland extras
hyprsunset
swww
wlogout

# terminal / dev
neovim
helix
fd-find
zoxide
eza
bat
lazygit
gh

# tuning and capture
lact
# goverlay is a flatpak instead (see flatpaks.list): the native package
# hard-requires Fedora's mangohud, which owns the same files as the
# terra-mangohud Bazzite ships on F44 and is a version behind it. Installing it
# aborts the whole RPM transaction with a file conflict.
obs-studio
imv

# SoberStrap runs against the system Qt
python3-pyqt6

# windows compatibility. Bottles, ProtonPlus and protontricks are flatpaks and
# live in flatpaks.list; this is the native Wine they drive.
wine
winetricks

# gum: the settings CLI calls it 15 times. It comes from the Bazzite base today,
# but listing it explicitly means an upstream drop shows up as a skipped package
# in catspaw-verify instead of a settings command that dies on first use.
gum

# node is shipped system-wide so catspaw-claude can install Claude Code into the
# user's home without them having to source a version manager first.
nodejs
npm

# moved out of the mandatory block in build.sh: useful, but the desktop boots
# without it, so it must not be able to fail the image
java-21-openjdk-devel

# zenity: the desktop switcher falls back to it for its menu under GNOME,
# whose Mutter has no wlr-layer-shell and so cannot run wofi at all.
zenity
